{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/onepiece-studio/luan-sounds/main/schema/luan-v1.schema.json",
  "title": "Luan sound repository manifest (luan.json), schemaVersion 1",
  "description": "Structural rules only. File hashes, sizes, audio format, duration and the 64 MiB total are checked by tools/luan_repo.py. Unknown fields and unknown event keys are allowed and ignored by Luan.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "not": { "const": "builtin" }
    },
    "name": { "$ref": "#/$defs/name" },
    "description": { "$ref": "#/$defs/description" },
    "localizations": { "$ref": "#/$defs/localizations" },
    "author": { "$ref": "#/$defs/author" },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/pack" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "description": { "type": "string", "maxLength": 280 },
    "localizations": {
      "description": "Display text per BCP 47 language tag (case-insensitive). Luan uses the best match for the user's preferred languages and falls back to the main fields.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "description": { "$ref": "#/$defs/description" }
        }
      }
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s/?#@]+([/?#]\\S*)?$" },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "pack": {
      "type": "object",
      "required": ["id", "name", "version", "sounds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "localizations": { "$ref": "#/$defs/localizations" },
        "version": { "type": "integer", "minimum": 1 },
        "license": {
          "type": "string",
          "pattern": "^(LicenseRef-[A-Za-z0-9.-]+|(?!LicenseRef-)[A-Za-z0-9][A-Za-z0-9.+-]*)$"
        },
        "author": { "$ref": "#/$defs/author" },
        "sounds": {
          "type": "object",
          "properties": {
            "session-start": { "$ref": "#/$defs/sound" },
            "task-acknowledge": { "$ref": "#/$defs/sound" },
            "task-complete": { "$ref": "#/$defs/sound" },
            "task-error": { "$ref": "#/$defs/sound" },
            "input-required": { "$ref": "#/$defs/sound" },
            "input-required-question": { "$ref": "#/$defs/sound" },
            "resource-limit": { "$ref": "#/$defs/sound" },
            "user-spam": { "$ref": "#/$defs/sound" },
            "idle-reminder": { "$ref": "#/$defs/sound" }
          },
          "anyOf": [
            { "required": ["session-start"] },
            { "required": ["task-acknowledge"] },
            { "required": ["task-complete"] },
            { "required": ["task-error"] },
            { "required": ["input-required"] },
            { "required": ["input-required-question"] },
            { "required": ["resource-limit"] },
            { "required": ["user-spam"] },
            { "required": ["idle-reminder"] }
          ]
        }
      }
    },
    "sound": {
      "type": "object",
      "required": ["file", "sha256", "size"],
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\\.wav$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0, "maximum": 2097152 }
      }
    }
  }
}
